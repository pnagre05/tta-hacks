# Optional. The app runs locally with no .env at all.
# Copy this file to .env only if you want to change something. Never commit .env.

PORT=4000

# Defaults to a local development value if unset. Set a long random string for anything shared.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# GATHER AI (optional). Without a key, the assistant answers from a built-in summary.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5

# Database. Unset = local PGlite, stored in server/data/ (use GATHER_DB=memory for a throwaway one).
# Set DATABASE_URL to use real Postgres such as Supabase (use the Session pooler connection string):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Hosts that reserve the name DATABASE_URL (such as Replit) can use SUPABASE_DB_URL instead. It takes priority.
# SUPABASE_DB_URL=
# GATHER_DB=memory
