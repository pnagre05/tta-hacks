# Copy this file to .env and fill it in. Never commit .env.

PORT=4000
DATABASE_URL=postgres://postgres:gather@localhost:5432/postgres

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=64-hex-characters-from-the-command-above

# Where people open the app. Used to send them back after Google sign-in.
# LAN example: http://192.168.1.20:4000   Tunnel example: https://abc123.ngrok-free.app
APP_URL=http://localhost:4000

# Set to true when the app is served over HTTPS (tunnel or deployment)
COOKIE_SECURE=false

# Google Calendar (from Google Cloud console > Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Google only accepts https or localhost, so use your tunnel URL here.
GOOGLE_REDIRECT_URI=https://your-tunnel-url/api/calendar/callback

# GATHER AI (optional). Without a key, the assistant answers from a built-in summary.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
